HOST=127.0.0.1
PORT=3000
KRAKEN_BASE_URL=https://api.kraken.com
DATA_DIR=./data
TRADING_MODE=paper

PAPER_STARTING_CAD=500
PAPER_TRADE_TARGET=200
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=1
MAX_EXPOSURE_PCT=50
REWARD_RISK=2
KRAKEN_MAKER_FEE_PCT=0.25
KRAKEN_TAKER_FEE_PCT=0.40
SLIPPAGE_ALLOWANCE_PCT=0.05
MAX_SPREAD_PCT=0.25

# Paper automation (default safe mode).
AUTO_PAPER_TRADING=true
AUTO_TRADER_POLL_SECONDS=60
# Optional learning-data mode. It can simulate one separate shadow position
# only while the main paper account is blocked by its daily risk protection.
SHADOW_LOGGING_ENABLED=true
SHADOW_WHEN_DAILY_BLOCKED=true
SHADOW_STATE_FILE=./data/shadow-state.json
SHADOW_JOURNAL_FILE=./data/shadow-trades.jsonl
# The bot checks Kraken AssetPairs once per pair and skips markets that are not online.
AUTO_TRADER_PAIRS=BTC/USD,ETH/USD,SOL/USD,XRP/USD,ADA/USD,DOGE/USD,LINK/USD,LTC/USD,AVAX/USD,DOT/USD
COINBASE_BASE_URL=https://api.exchange.coinbase.com
# manual = local news:clear/news:block commands.
# openai = live web search only after a confirmed technical candidate.
# paper-auto = automatically refreshes the gate in PAPER mode only; no external news verification.
AUTO_NEWS_PROVIDER=paper-auto
AUTO_NEWS_GATE_FILE=./data/news-gate.json
AUTO_NEWS_MAX_AGE_SECONDS=900
OPENAI_NEWS_MODEL=gpt-5.4-mini
# Required only when AUTO_NEWS_PROVIDER=openai and AUTO_PAPER_TRADING=true.
# OpenAI API usage is billed separately from a ChatGPT subscription.
OPENAI_API_KEY=

# Optional Telegram reports. Create the bot with @BotFather, then keep both
# values only in this local .env file. WAIT/NO_TRADE events are never sent.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_STARTUP=true
# important = open/close/blocker/error/final; all = every bot event.
TELEGRAM_NOTIFICATION_MODE=all

# Private Kraken keys are optional in paper mode. They are required for
# validate_kraken_order or guarded live mode. Keep them local only.
ENABLE_KRAKEN_ORDER_VALIDATION=false
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Guarded live mode. Leave every value below disabled until paper testing passes.
# Never place this .env in OneDrive/Dropbox/Git and never paste either key into chat.
AUTO_LIVE_TRADING=false
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACK=
LIVE_CAPITAL_CAP_CAD=500
LIVE_MAX_ORDER_CAD=250
LIVE_ENTRY_SLIPPAGE_PCT=0.25
LIVE_EXIT_SLIPPAGE_PCT=0.25
LIVE_ARM_MAX_AGE_MINUTES=60
LIVE_STATE_FILE=./data/live-state.json
LIVE_JOURNAL_FILE=./data/live-trader.jsonl
LIVE_ARM_FILE=./data/live-armed.json
LIVE_KILL_SWITCH_FILE=./data/LIVE_STOP
