{
  "name": "crypto-trading-mcp",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "description": "Guarded paper and optional live Kraken spot day-trading tools for ChatGPT over MCP.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "news:clear": "tsx src/newsGateCli.ts clear",
    "news:block": "tsx src/newsGateCli.ts blocked",
    "shadow:status": "tsx src/shadowStatusCli.ts",
    "telegram:chat-id": "tsx src/telegramChatIdCli.ts",
    "telegram:test": "tsx src/telegramTestCli.ts",
    "live:arm": "tsx src/liveControlCli.ts arm",
    "live:stop": "tsx src/liveControlCli.ts stop",
    "live:status": "tsx src/liveControlCli.ts status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
